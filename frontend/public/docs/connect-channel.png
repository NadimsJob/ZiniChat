<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 480" width="100%" height="100%">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0b0f19"/>
      <stop offset="100%" stop-color="#111827"/>
    </linearGradient>
    <linearGradient id="greenGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1F824A"/>
      <stop offset="100%" stop-color="#145932"/>
    </linearGradient>
    <linearGradient id="orangeGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#EE8D27"/>
      <stop offset="100%" stop-color="#C76B13"/>
    </linearGradient>
    <linearGradient id="cardGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#1f293d" stop-opacity="0.8"/>
      <stop offset="100%" stop-color="#111827" stop-opacity="0.9"/>
    </linearGradient>
  </defs>

  <rect width="900" height="480" rx="16" fill="url(#bgGrad)"/>
  <rect width="898" height="478" x="1" y="1" rx="15" fill="none" stroke="#ffffff" stroke-opacity="0.1" stroke-width="1"/>

  <!-- Top Bar -->
  <rect x="20" y="20" width="860" height="44" rx="10" fill="#182234" stroke="#ffffff" stroke-opacity="0.08"/>
  <circle cx="44" cy="42" r="6" fill="#ef4444"/>
  <circle cx="64" cy="42" r="6" fill="#f59e0b"/>
  <circle cx="84" cy="42" r="6" fill="#10b981"/>
  <text x="450" y="47" text-anchor="middle" fill="#94a3b8" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="13" font-weight="600">ZiniChat — Connected Inboxes Settings</text>

  <!-- Content Header -->
  <text x="40" y="100" fill="#ffffff" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="20" font-weight="700">Connect Communication Channels</text>
  <text x="40" y="122" fill="#94a3b8" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="13">Select a platform below to link your customer inbox</text>

  <!-- Card 1: Facebook & Instagram -->
  <rect x="40" y="150" width="260" height="280" rx="14" fill="url(#cardGrad)" stroke="#3b82f6" stroke-opacity="0.4" stroke-width="1.5"/>
  <circle cx="80" cy="195" r="22" fill="#1877f2" fill-opacity="0.2"/>
  <path d="M73 195c0-3.86 3.14-7 7-7s7 3.14 7 7c0 3.48-2.55 6.37-5.91 6.9v-4.88h1.96l.37-2.02h-2.33v-1.31c0-.56.27-1.1.15-1.1h1.27v-1.72s-1.15-.2-2.25-.2c-2.3 0-3.8 1.4-3.8 3.92v1.41h-1.78v2.02h1.78v4.88C75.55 201.37 73 198.48 73 195z" fill="#3b82f6"/>
  <text x="114" y="200" fill="#ffffff" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="15" font-weight="700">Facebook &amp; IG</text>
  <text x="60" y="235" fill="#94a3b8" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="12">Connect Page Messenger &amp; Instagram DM via Official Meta API</text>
  
  <rect x="60" y="270" width="220" height="32" rx="8" fill="#3b82f6"/>
  <text x="170" y="291" text-anchor="middle" fill="#ffffff" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="12" font-weight="700">Connect Meta Account</text>
  <rect x="60" y="315" width="220" height="26" rx="6" fill="#10b981" fill-opacity="0.15"/>
  <text x="170" y="332" text-anchor="middle" fill="#34d399" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="11" font-weight="600">✓ Official Meta Tech Provider</text>

  <!-- Card 2: WhatsApp Cloud API / Web -->
  <rect x="320" y="150" width="260" height="280" rx="14" fill="url(#cardGrad)" stroke="#10b981" stroke-opacity="0.4" stroke-width="1.5"/>
  <circle cx="360" cy="195" r="22" fill="#10b981" fill-opacity="0.2"/>
  <path d="M353 195c0 3.87 3.13 7 7 7 1.24 0 2.4-.32 3.41-.88l3.59.94-.96-3.5c.62-1.04.96-2.25.96-3.56 0-3.87-3.13-7-7-7s-7 3.13-7 7z" fill="#10b981"/>
  <text x="394" y="200" fill="#ffffff" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="15" font-weight="700">WhatsApp</text>
  <text x="340" y="235" fill="#94a3b8" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="12">Link WhatsApp Business Cloud API or scan QR code via Baileys Web</text>
  
  <rect x="340" y="270" width="220" height="32" rx="8" fill="url(#greenGrad)"/>
  <text x="450" y="291" text-anchor="middle" fill="#ffffff" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="12" font-weight="700">Connect WhatsApp</text>
  <rect x="340" y="315" width="220" height="26" rx="6" fill="#10b981" fill-opacity="0.15"/>
  <text x="450" y="332" text-anchor="middle" fill="#34d399" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="11" font-weight="600">✓ QR Code &amp; Cloud API</text>

  <!-- Card 3: Live Chat & WhatsApp Widget -->
  <rect x="600" y="150" width="260" height="280" rx="14" fill="url(#cardGrad)" stroke="#8b5cf6" stroke-opacity="0.4" stroke-width="1.5"/>
  <circle cx="640" cy="195" r="22" fill="#8b5cf6" fill-opacity="0.2"/>
  <path d="M633 190h14v10h-14z" fill="#8b5cf6"/>
  <text x="674" y="200" fill="#ffffff" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="15" font-weight="700">Web Widget</text>
  <text x="620" y="235" fill="#94a3b8" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="12">Embed customizable live chat or floating WhatsApp button on your website</text>
  
  <rect x="620" y="270" width="220" height="32" rx="8" fill="#8b5cf6"/>
  <text x="730" y="291" text-anchor="middle" fill="#ffffff" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="12" font-weight="700">Create Web Widget</text>
  <rect x="620" y="315" width="220" height="26" rx="6" fill="#8b5cf6" fill-opacity="0.15"/>
  <text x="730" y="332" text-anchor="middle" fill="#c084fc" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="11" font-weight="600">✓ 1-Click Script Embed</text>
</svg>
