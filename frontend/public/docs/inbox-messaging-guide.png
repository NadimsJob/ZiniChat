<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 920 540" width="100%" height="100%">
  <defs>
    <style>
      .bg-app { fill: #090d16; }
      .bg-card { fill: #121827; stroke: #1f293d; stroke-width: 1; }
      .text-white { fill: #ffffff; font-family: -apple-system, BlinkMacSystemFont, sans-serif; }
      .text-muted { fill: #94a3b8; font-family: -apple-system, BlinkMacSystemFont, sans-serif; }
      .text-green { fill: #34d399; font-family: -apple-system, BlinkMacSystemFont, sans-serif; }
    </style>
    <linearGradient id="primaryGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1F824A"/>
      <stop offset="100%" stop-color="#145932"/>
    </linearGradient>
    <linearGradient id="orangeGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#EE8D27"/>
      <stop offset="100%" stop-color="#C76B13"/>
    </linearGradient>
  </defs>

  <rect width="920" height="540" rx="16" fill="#090d16"/>
  <rect width="918" height="538" x="1" y="1" rx="15" fill="none" stroke="#26334d" stroke-width="1"/>

  <!-- Top App Bar -->
  <rect x="0" y="0" width="920" height="42" fill="#121827"/>
  <circle cx="24" cy="21" r="5.5" fill="#ef4444"/>
  <circle cx="40" cy="21" r="5.5" fill="#f59e0b"/>
  <circle cx="56" cy="21" r="5.5" fill="#10b981"/>
  <text x="460" y="26" text-anchor="middle" class="text-muted" font-size="12" font-weight="600">ZiniChat — Omnichannel Live Inbox</text>

  <!-- Channel Filter Tabs Bar -->
  <rect x="20" y="52" width="880" height="44" rx="10" fill="#161e2e" stroke="#26334d"/>
  <rect x="30" y="60" width="105" height="28" rx="14" fill="#10b981" fill-opacity="0.2" stroke="#10b981" stroke-opacity="0.5"/>
  <text x="82" y="78" text-anchor="middle" class="text-green" font-size="12" font-weight="700">All Channels</text>

  <rect x="145" y="60" width="100" height="28" rx="14" fill="#1f293d"/>
  <text x="195" y="78" text-anchor="middle" class="text-muted" font-size="12">WhatsApp</text>

  <rect x="255" y="60" width="100" height="28" rx="14" fill="#1f293d"/>
  <text x="305" y="78" text-anchor="middle" class="text-muted" font-size="12">Messenger</text>

  <rect x="365" y="60" width="100" height="28" rx="14" fill="#1f293d"/>
  <text x="415" y="78" text-anchor="middle" class="text-muted" font-size="12">Instagram</text>

  <rect x="475" y="60" width="100" height="28" rx="14" fill="#1f293d"/>
  <text x="525" y="78" text-anchor="middle" class="text-muted" font-size="12">Live Chat</text>

  <!-- Left Sidebar: Conversations Stream -->
  <rect x="20" y="105" width="270" height="415" rx="12" class="bg-card"/>
  
  <!-- Conv Item 1 Active -->
  <rect x="30" y="115" width="250" height="72" rx="10" fill="#1F824A" fill-opacity="0.18" stroke="#10b981" stroke-opacity="0.4"/>
  <circle cx="58" cy="151" r="18" fill="#1877f2"/>
  <text x="58" y="156" text-anchor="middle" class="text-white" font-size="13" font-weight="700">N</text>
  <circle cx="70" cy="163" r="4" fill="#10b981"/>
  <text x="86" y="142" class="text-white" font-size="13" font-weight="700">Nadim Hasan</text>
  <text x="86" y="160" class="text-green" font-size="11">What is the item price?</text>
  <text x="245" y="142" text-anchor="end" class="text-muted" font-size="10">12:42 PM</text>

  <!-- Conv Item 2 -->
  <rect x="30" y="195" width="250" height="72" rx="10" fill="#1f293d"/>
  <circle cx="58" cy="231" r="18" fill="#10b981"/>
  <text x="58" y="236" text-anchor="middle" class="text-white" font-size="13" font-weight="700">R</text>
  <text x="86" y="222" class="text-white" font-size="13" font-weight="600">Rahim Store</text>
  <text x="86" y="240" class="text-muted" font-size="11">Order confirmed. Thanks!</text>
  <text x="245" y="222" text-anchor="end" class="text-muted" font-size="10">11:15 AM</text>

  <!-- Middle Panel: Active Chat Thread -->
  <rect x="300" y="105" width="410" height="415" rx="12" class="bg-card"/>
  <!-- Header bar -->
  <rect x="300" y="105" width="410" height="52" rx="12" fill="#161e2e"/>
  <text x="320" y="136" class="text-white" font-size="14" font-weight="700">Nadim Hasan (+8801700000000)</text>
  <rect x="580" y="119" width="115" height="24" rx="12" fill="#10b981" fill-opacity="0.2"/>
  <text x="637" y="135" text-anchor="middle" class="text-green" font-size="11" font-weight="700">🤖 AI Active</text>

  <!-- Incoming Bubble -->
  <rect x="320" y="175" width="230" height="42" rx="12" fill="#1f293d"/>
  <text x="335" y="201" class="text-white" font-size="12">Hello! What is the product price?</text>

  <!-- Outbound AI Bubble -->
  <rect x="440" y="230" width="250" height="58" rx="12" fill="url(#primaryGrad)"/>
  <text x="455" y="252" class="text-white" font-size="12">Hello! The item price is ৳ 1,250 BDT. Delivery charge is ৳ 70 BDT.</text>

  <!-- Incoming Bubble 2 -->
  <rect x="320" y="300" width="190" height="42" rx="12" fill="#1f293d"/>
  <text x="335" y="326" class="text-white" font-size="12">I would like to place an order.</text>

  <!-- Message Input Bar -->
  <rect x="315" y="468" width="380" height="40" rx="20" fill="#18181b" stroke="#27272a"/>
  <text x="335" y="492" class="text-muted" font-size="12">Type message or let AI auto-reply...</text>
  <circle cx="675" cy="488" r="14" fill="url(#primaryGrad)"/>
  <text x="675" y="493" text-anchor="middle" class="text-white" font-size="12">➤</text>

  <!-- Right Sidebar: Customer CRM Info -->
  <rect x="720" y="105" width="180" height="415" rx="12" class="bg-card"/>
  <text x="735" y="135" class="text-white" font-size="13" font-weight="700">Contact CRM Info</text>
  <text x="735" y="160" class="text-muted" font-size="11">Phone: +8801700000000</text>
  <text x="735" y="180" class="text-muted" font-size="11">Channel: Messenger</text>
  
  <rect x="735" y="210" width="150" height="32" rx="8" fill="url(#orangeGrad)"/>
  <text x="810" y="231" text-anchor="middle" class="text-white" font-size="12" font-weight="700">+ Create Order</text>

  <rect x="735" y="252" width="150" height="32" rx="8" fill="#3b82f6" fill-opacity="0.2" stroke="#3b82f6" stroke-opacity="0.4"/>
  <text x="810" y="273" text-anchor="middle" fill="#60a5fa" font-size="11" font-weight="700">Generate AI Summary</text>
</svg>
