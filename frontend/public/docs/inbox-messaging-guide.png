<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 480" width="100%" height="100%">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0b0f19"/>
      <stop offset="100%" stop-color="#111827"/>
    </linearGradient>
    <linearGradient id="greenGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1F824A"/>
      <stop offset="100%" stop-color="#145932"/>
    </linearGradient>
  </defs>

  <rect width="900" height="480" rx="16" fill="url(#bgGrad)"/>
  <rect width="898" height="478" x="1" y="1" rx="15" fill="none" stroke="#ffffff" stroke-opacity="0.1" stroke-width="1"/>

  <!-- Top Filter Bar -->
  <rect x="20" y="20" width="860" height="44" rx="10" fill="#182234" stroke="#ffffff" stroke-opacity="0.08"/>
  <rect x="35" y="28" width="90" height="28" rx="14" fill="#10b981" fill-opacity="0.2" stroke="#10b981" stroke-opacity="0.5"/>
  <text x="80" y="46" text-anchor="middle" fill="#34d399" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="12" font-weight="700">All (128)</text>

  <rect x="135" y="28" width="100" height="28" rx="14" fill="#1f293d"/>
  <text x="185" y="46" text-anchor="middle" fill="#94a3b8" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="12">WhatsApp</text>

  <rect x="245" y="28" width="100" height="28" rx="14" fill="#1f293d"/>
  <text x="295" y="46" text-anchor="middle" fill="#94a3b8" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="12">Messenger</text>

  <rect x="355" y="28" width="100" height="28" rx="14" fill="#1f293d"/>
  <text x="405" y="46" text-anchor="middle" fill="#94a3b8" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="12">Live Chat</text>

  <!-- Left Sidebar: Conversations List -->
  <rect x="20" y="75" width="280" height="385" rx="10" fill="#111827" stroke="#374151"/>
  
  <!-- Conv Item 1 -->
  <rect x="30" y="85" width="260" height="70" rx="8" fill="#1F824A" fill-opacity="0.15" stroke="#10b981" stroke-opacity="0.3"/>
  <circle cx="55" cy="120" r="16" fill="#3b82f6"/>
  <text x="55" y="125" text-anchor="middle" fill="#ffffff" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="12" font-weight="700">N</text>
  <text x="80" y="112" fill="#ffffff" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="13" font-weight="700">Nadim Hasan</text>
  <text x="80" y="130" fill="#a7f3d0" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="11">প্রোডাক্ট এর দাম কত?</text>
  <circle cx="270" cy="105" r="4" fill="#10b981"/>

  <!-- Conv Item 2 -->
  <rect x="30" y="165" width="260" height="70" rx="8" fill="#1f293d"/>
  <circle cx="55" cy="200" r="16" fill="#10b981"/>
  <text x="55" y="205" text-anchor="middle" fill="#ffffff" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="12" font-weight="700">R</text>
  <text x="80" y="192" fill="#ffffff" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="13" font-weight="600">Rahim Store</text>
  <text x="80" y="210" fill="#94a3b8" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="11">Order confirmed. Thanks!</text>

  <!-- Middle: Active Chat Window -->
  <rect x="310" y="75" width="370" height="385" rx="10" fill="#111827" stroke="#374151"/>
  <!-- Chat Header -->
  <rect x="310" y="75" width="370" height="50" rx="10" fill="#182234"/>
  <text x="330" y="105" fill="#ffffff" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="14" font-weight="700">Nadim Hasan</text>
  <rect x="580" y="88" width="85" height="24" rx="12" fill="#10b981" fill-opacity="0.2"/>
  <text x="622" y="104" text-anchor="middle" fill="#34d399" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="11" font-weight="700">🤖 AI Active</text>

  <!-- Incoming Message -->
  <rect x="330" y="145" width="220" height="42" rx="12" fill="#1f293d"/>
  <text x="345" y="170" fill="#e2e8f0" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="12">আসসালামু আলাইকুম, প্রোডাক্টের দাম কত?</text>

  <!-- AI Outbound Message -->
  <rect x="440" y="200" width="220" height="58" rx="12" fill="url(#greenGrad)"/>
  <text x="455" y="222" fill="#ffffff" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="12">ওয়ালাইকুম আসসালাম! প্রোডাক্টের দাম ১২৫০ টাকা। কুরিয়ার চার্জ ৭০ টাকা।</text>

  <!-- Message Input Bar -->
  <rect x="325" y="410" width="340" height="40" rx="20" fill="#1f293d" stroke="#374151"/>
  <text x="345" y="434" fill="#64748b" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="12">Type reply or let AI respond...</text>

  <!-- Right Sidebar: Customer Profile & Actions -->
  <rect x="690" y="75" width="190" height="385" rx="10" fill="#111827" stroke="#374151"/>
  <text x="710" y="105" fill="#ffffff" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="13" font-weight="700">Contact Details</text>
  <text x="710" y="130" fill="#94a3b8" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="11">+8801700000000</text>
  
  <rect x="705" y="150" width="160" height="28" rx="6" fill="#EE8D27" fill-opacity="0.2"/>
  <text x="785" y="168" text-anchor="middle" fill="#fb923c" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="11" font-weight="700">+ Create Order</text>

  <rect x="705" y="190" width="160" height="28" rx="6" fill="#3b82f6" fill-opacity="0.2"/>
  <text x="785" y="208" text-anchor="middle" fill="#60a5fa" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="11" font-weight="700">Generate AI Summary</text>
</svg>
