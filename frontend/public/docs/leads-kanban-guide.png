<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 480" width="100%" height="100%">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0b0f19"/>
      <stop offset="100%" stop-color="#111827"/>
    </linearGradient>
  </defs>

  <rect width="900" height="480" rx="16" fill="url(#bgGrad)"/>
  <rect width="898" height="478" x="1" y="1" rx="15" fill="none" stroke="#ffffff" stroke-opacity="0.1" stroke-width="1"/>

  <!-- Top Bar -->
  <rect x="20" y="20" width="860" height="44" rx="10" fill="#182234" stroke="#ffffff" stroke-opacity="0.08"/>
  <text x="40" y="47" fill="#ffffff" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="14" font-weight="700">Multi-Vertical CRM Leads Kanban Pipeline</text>

  <!-- Column 1: New Leads -->
  <rect x="20" y="80" width="270" height="375" rx="10" fill="#111827" stroke="#374151"/>
  <rect x="20" y="80" width="270" height="40" rx="10" fill="#3b82f6" fill-opacity="0.2"/>
  <text x="35" y="105" fill="#60a5fa" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="13" font-weight="700">New Inquiries (4)</text>

  <rect x="30" y="130" width="250" height="80" rx="8" fill="#1f293d"/>
  <text x="45" y="152" fill="#ffffff" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="12" font-weight="700">Nadim Hasan</text>
  <text x="45" y="170" fill="#94a3b8" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="11">WhatsApp • Leather Jacket Inquiry</text>
  <text x="45" y="190" fill="#34d399" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="11">Value: ৳ 2,450</text>

  <!-- Column 2: In Discussion -->
  <rect x="315" y="80" width="270" height="375" rx="10" fill="#111827" stroke="#374151"/>
  <rect x="315" y="80" width="270" height="40" rx="10" fill="#f59e0b" fill-opacity="0.2"/>
  <text x="330" y="105" fill="#fbbf24" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="13" font-weight="700">In Discussion / Demo (2)</text>

  <rect x="325" y="130" width="250" height="80" rx="8" fill="#1f293d"/>
  <text x="340" y="152" fill="#ffffff" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="12" font-weight="700">Software Demo Request</text>
  <text x="340" y="170" fill="#94a3b8" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="11">Messenger • Auto AI Moved Stage</text>
  <text x="340" y="190" fill="#fbbf24" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="11">Scheduled for Tomorrow</text>

  <!-- Column 3: Closed Won -->
  <rect x="610" y="80" width="270" height="375" rx="10" fill="#111827" stroke="#374151"/>
  <rect x="610" y="80" width="270" height="40" rx="10" fill="#10b981" fill-opacity="0.2"/>
  <text x="625" y="105" fill="#34d399" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="13" font-weight="700">Closed / Won (12)</text>

  <rect x="620" y="130" width="250" height="80" rx="8" fill="#1f293d"/>
  <text x="635" y="152" fill="#ffffff" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="12" font-weight="700">Rahim Store</text>
  <text x="635" y="170" fill="#94a3b8" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="11">Paid &amp; Shipped • ৳ 12,500</text>
  <text x="635" y="190" fill="#34d399" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="11">✓ Deal Completed</text>
</svg>
