<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 480" width="100%" height="100%">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0b0f19"/>
      <stop offset="100%" stop-color="#111827"/>
    </linearGradient>
    <linearGradient id="orangeGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#EE8D27"/>
      <stop offset="100%" stop-color="#C76B13"/>
    </linearGradient>
  </defs>

  <rect width="900" height="480" rx="16" fill="url(#bgGrad)"/>
  <rect width="898" height="478" x="1" y="1" rx="15" fill="none" stroke="#ffffff" stroke-opacity="0.1" stroke-width="1"/>

  <!-- Top Bar -->
  <rect x="20" y="20" width="860" height="44" rx="10" fill="#182234" stroke="#ffffff" stroke-opacity="0.08"/>
  <text x="40" y="47" fill="#ffffff" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="14" font-weight="700">Catalog &amp; Multi-Vertical Orders Management</text>
  <rect x="730" y="28" width="130" height="28" rx="6" fill="url(#orangeGrad)"/>
  <text x="795" y="46" text-anchor="middle" fill="#ffffff" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="12" font-weight="600">+ Add Product</text>

  <!-- Table Container -->
  <rect x="20" y="80" width="860" height="375" rx="12" fill="#111827" stroke="#374151"/>
  
  <!-- Table Header -->
  <rect x="20" y="80" width="860" height="45" rx="12" fill="#1f293d"/>
  <text x="40" y="108" fill="#94a3b8" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="12" font-weight="700">PRODUCT / SERVICE</text>
  <text x="300" y="108" fill="#94a3b8" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="12" font-weight="700">PRICE</text>
  <text x="440" y="108" fill="#94a3b8" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="12" font-weight="700">STOCK / STATUS</text>
  <text x="620" y="108" fill="#94a3b8" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="12" font-weight="700">VERTICAL MODE</text>
  <text x="780" y="108" fill="#94a3b8" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="12" font-weight="700">ACTIONS</text>

  <!-- Row 1 -->
  <line x1="20" y1="180" x2="880" y2="180" stroke="#374151" stroke-width="1"/>
  <rect x="40" y="138" width="32" height="32" rx="6" fill="#3b82f6" fill-opacity="0.2"/>
  <text x="82" y="152" fill="#ffffff" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="13" font-weight="700">Premium Leather Jacket</text>
  <text x="82" y="167" fill="#94a3b8" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="11">SKU: JK-9901 • Color: Black</text>
  <text x="300" y="158" fill="#34d399" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="13" font-weight="700">৳ 2,450</text>
  <rect x="440" y="143" width="90" height="24" rx="12" fill="#10b981" fill-opacity="0.2"/>
  <text x="485" y="159" text-anchor="middle" fill="#34d399" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="11" font-weight="600">In Stock (45)</text>
  <rect x="620" y="143" width="90" height="24" rx="12" fill="#3b82f6" fill-opacity="0.2"/>
  <text x="665" y="159" text-anchor="middle" fill="#60a5fa" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="11" font-weight="600">Retail</text>
  <text x="780" y="158" fill="#fb923c" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="12" font-weight="600">Edit / Sync</text>

  <!-- Row 2 -->
  <line x1="20" y1="240" x2="880" y2="240" stroke="#374151" stroke-width="1"/>
  <rect x="40" y="198" width="32" height="32" rx="6" fill="#8b5cf6" fill-opacity="0.2"/>
  <text x="82" y="212" fill="#ffffff" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="13" font-weight="700">Executive Office Suite 402</text>
  <text x="82" y="227" fill="#94a3b8" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="11">Property Mode • 1,200 sqft</text>
  <text x="300" y="218" fill="#facc15" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="12" font-style="italic">Price on Call</text>
  <rect x="440" y="203" width="90" height="24" rx="12" fill="#f59e0b" fill-opacity="0.2"/>
  <text x="485" y="219" text-anchor="middle" fill="#fbbf24" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="11" font-weight="600">Available</text>
  <rect x="620" y="203" width="100" height="24" rx="12" fill="#8b5cf6" fill-opacity="0.2"/>
  <text x="670" y="219" text-anchor="middle" fill="#c084fc" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="11" font-weight="600">Real Estate</text>
  <text x="780" y="218" fill="#fb923c" font-family="-apple-system, BlinkMacSystemFont, sans-serif" font-size="12" font-weight="600">Edit / Sync</text>
</svg>
