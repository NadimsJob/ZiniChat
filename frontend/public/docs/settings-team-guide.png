<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 920 540" width="100%" height="100%">
  <defs>
    <style>
      .bg-app { fill: #090d16; }
      .bg-card { fill: #121827; stroke: #1f293d; stroke-width: 1; }
      .text-white { fill: #ffffff; font-family: -apple-system, BlinkMacSystemFont, sans-serif; }
      .text-muted { fill: #94a3b8; font-family: -apple-system, BlinkMacSystemFont, sans-serif; }
      .text-green { fill: #34d399; font-family: -apple-system, BlinkMacSystemFont, sans-serif; }
    </style>
    <linearGradient id="primaryGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1F824A"/>
      <stop offset="100%" stop-color="#145932"/>
    </linearGradient>
  </defs>

  <rect width="920" height="540" rx="16" fill="#090d16"/>
  <rect width="918" height="538" x="1" y="1" rx="15" fill="none" stroke="#26334d" stroke-width="1"/>

  <!-- Top App Bar -->
  <rect x="0" y="0" width="920" height="42" fill="#121827"/>
  <circle cx="24" cy="21" r="5.5" fill="#ef4444"/>
  <circle cx="40" cy="21" r="5.5" fill="#f59e0b"/>
  <circle cx="56" cy="21" r="5.5" fill="#10b981"/>
  <text x="460" y="26" text-anchor="middle" class="text-muted" font-size="12" font-weight="600">ZiniChat — Team Roles &amp; Granular Access Permissions</text>

  <!-- Page Header -->
  <rect x="30" y="58" width="860" height="55" rx="10" fill="#161e2e" stroke="#26334d"/>
  <text x="50" y="86" class="text-white" font-size="16" font-weight="700">Team Members &amp; Access Permissions</text>
  <text x="50" y="103" class="text-muted" font-size="11">Invite support agents or managers and delegate specific workspace module permissions.</text>
  
  <rect x="745" y="70" width="130" height="32" rx="8" fill="url(#primaryGrad)"/>
  <text x="810" y="91" text-anchor="middle" class="text-white" font-size="12" font-weight="700">+ Invite Member</text>

  <!-- Left: Team Members -->
  <rect x="30" y="125" width="400" height="385" rx="12" class="bg-card"/>
  <text x="50" y="155" class="text-white" font-size="14" font-weight="700">Team Members (3/5 Seats Used)</text>

  <rect x="50" y="175" width="360" height="68" rx="10" fill="#1f293d"/>
  <circle cx="78" cy="209" r="18" fill="#10b981"/>
  <text x="78" y="214" text-anchor="middle" class="text-white" font-size="13" font-weight="700">N</text>
  <text x="108" y="200" class="text-white" font-size="14" font-weight="700">Nadim (Account Owner)</text>
  <text x="108" y="218" class="text-muted" font-size="11">nadim@zinichat.com • Full Super Admin</text>

  <rect x="50" y="255" width="360" height="68" rx="10" fill="#1f293d"/>
  <circle cx="78" cy="289" r="18" fill="#3b82f6"/>
  <text x="78" y="294" text-anchor="middle" class="text-white" font-size="13" font-weight="700">S</text>
  <text x="108" y="280" class="text-white" font-size="14" font-weight="700">Sarah Agent (Sales Agent)</text>
  <text x="108" y="298" class="text-muted" font-size="11">sarah@zinichat.com • Custom Permissions</text>

  <!-- Right: Granular Access Toggles -->
  <rect x="450" y="125" width="440" height="385" rx="12" class="bg-card"/>
  <text x="470" y="155" class="text-white" font-size="14" font-weight="700">Granular Role Permissions</text>

  <rect x="470" y="175" width="400" height="48" rx="10" fill="#1f293d"/>
  <text x="490" y="204" class="text-white" font-size="12" font-weight="600">Access Live Inbox &amp; Reply Customer Messages</text>
  <rect x="820" y="189" width="36" height="20" rx="10" fill="#10b981"/>
  <circle cx="846" cy="199" r="8" fill="#ffffff"/>

  <rect x="470" y="235" width="400" height="48" rx="10" fill="#1f293d"/>
  <text x="490" y="264" class="text-white" font-size="12" font-weight="600">Create &amp; Edit Catalog Products</text>
  <rect x="820" y="249" width="36" height="20" rx="10" fill="#10b981"/>
  <circle cx="846" cy="259" r="8" fill="#ffffff"/>

  <rect x="470" y="295" width="400" height="48" rx="10" fill="#1f293d"/>
  <text x="490" y="324" class="text-white" font-size="12" font-weight="600">Modify AI Training &amp; System Persona Prompt</text>
  <rect x="820" y="309" width="36" height="20" rx="10" fill="#374151"/>
  <circle cx="830" cy="319" r="8" fill="#94a3b8"/>

  <rect x="470" y="355" width="400" height="48" rx="10" fill="#1f293d"/>
  <text x="490" y="384" class="text-white" font-size="12" font-weight="600">View Billing, Subscription &amp; Quotas</text>
  <rect x="820" y="369" width="36" height="20" rx="10" fill="#374151"/>
  <circle cx="830" cy="379" r="8" fill="#94a3b8"/>
</svg>
