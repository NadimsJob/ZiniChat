<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 920 540" width="100%" height="100%">
  <defs>
    <style>
      .bg-app { fill: #090d16; }
      .bg-card { fill: #121827; stroke: #1f293d; stroke-width: 1; }
      .text-white { fill: #ffffff; font-family: -apple-system, BlinkMacSystemFont, sans-serif; }
      .text-muted { fill: #94a3b8; font-family: -apple-system, BlinkMacSystemFont, sans-serif; }
      .text-purple { fill: #c084fc; font-family: -apple-system, BlinkMacSystemFont, sans-serif; }
    </style>
    <linearGradient id="widgetGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#7C3AED"/>
      <stop offset="100%" stop-color="#5B21B6"/>
    </linearGradient>
  </defs>

  <rect width="920" height="540" rx="16" fill="#090d16"/>
  <rect width="918" height="538" x="1" y="1" rx="15" fill="none" stroke="#26334d" stroke-width="1"/>

  <!-- Top App Bar -->
  <rect x="0" y="0" width="920" height="42" fill="#121827"/>
  <circle cx="24" cy="21" r="5.5" fill="#ef4444"/>
  <circle cx="40" cy="21" r="5.5" fill="#f59e0b"/>
  <circle cx="56" cy="21" r="5.5" fill="#10b981"/>
  <text x="460" y="26" text-anchor="middle" class="text-muted" font-size="12" font-weight="600">ZiniChat — Website Live Chat Widget Embed SDK (ওয়েবসাইট উইজেট সেটআপ)</text>

  <!-- Left: Embed Code -->
  <rect x="30" y="60" width="480" height="450" rx="14" class="bg-card"/>
  <text x="50" y="95" class="text-white" font-size="16" font-weight="700">1-Click Script Embed Code</text>

  <rect x="50" y="115" width="440" height="240" rx="10" fill="#18181b" stroke="#27272a"/>
  <text x="65" y="145" fill="#a7f3d0" font-family="monospace" font-size="12">&lt;!-- ZiniChat Live Chat Widget SDK --&gt;</text>
  <text x="65" y="175" fill="#c084fc" font-family="monospace" font-size="12">&lt;script src="https://zinichat.com/widget.js"</text>
  <text x="80" y="205" fill="#c084fc" font-family="monospace" font-size="12">data-token="622de982-7993-4778-b7c6..."</text>
  <text x="80" y="235" fill="#c084fc" font-family="monospace" font-size="12">data-color="#7C3AED"</text>
  <text x="80" y="265" fill="#c084fc" font-family="monospace" font-size="12">data-heading="Chat with us 👋"</text>
  <text x="65" y="295" fill="#c084fc" font-family="monospace" font-size="12">&gt;&lt;/script&gt;</text>

  <rect x="50" y="380" width="440" height="44" rx="10" fill="url(#widgetGrad)"/>
  <text x="270" y="407" text-anchor="middle" class="text-white" font-size="13" font-weight="700">📋 Copy HTML Embed Code</text>

  <!-- Right: Floating Widget Live Preview -->
  <rect x="530" y="60" width="360" height="450" rx="14" class="bg-card"/>
  <text x="550" y="95" class="text-white" font-size="15" font-weight="700">Live Website Preview</text>

  <!-- Chat Drawer Window -->
  <rect x="560" y="130" width="300" height="270" rx="14" fill="#1f293d" stroke="#374151"/>
  <rect x="560" y="130" width="300" height="50" rx="14" fill="url(#widgetGrad)"/>
  <text x="580" y="160" class="text-white" font-size="14" font-weight="700">Chat with us 👋</text>

  <rect x="575" y="195" width="220" height="40" rx="10" fill="#374151"/>
  <text x="590" y="220" class="text-white" font-size="11">Hello! How can we help you today?</text>

  <!-- Trigger Floating Button -->
  <circle cx="820" cy="455" r="26" fill="url(#widgetGrad)"/>
  <path d="M810 455h20v-2h-20z" fill="#ffffff"/>
</svg>
